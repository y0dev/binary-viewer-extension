{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2021"],
    "types": ["node", "vscode"],
    "rootDir": "src",
    "outDir": "out/extension",
    "noEmit": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/webview/**", "node_modules", "out", "dist"]
}
