{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2021", "DOM"],
    "types": ["node", "mocha", "vscode"],
    "rootDir": ".",
    "outDir": "out",
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noEmit": false
  },
  "include": ["src/**/*.ts", "test/**/*.ts"],
  "exclude": ["src/webview/**", "node_modules", "dist"]
}
