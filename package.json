{
  "name": "binary-structure-inspector",
  "displayName": "Binary Viewer & Structure Inspector",
  "description": "Hex/binary file viewer with a virtualized hex dump, data inspector, binary search, and user-defined binary structure decoding for embedded development.",
  "version": "0.19.0",
  "publisher": "devdoesit",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#171E2B",
    "theme": "dark"
  },
  "author": {
    "name": "Devontae Reid",
    "url": "https://www.devontaereid.com"
  },
  "homepage": "https://www.devontaereid.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/y0dev/binary-viewer-extension.git"
  },
  "bugs": {
    "url": "https://github.com/y0dev/binary-viewer-extension/issues"
  },
  "qna": false,
  "engines": {
    "vscode": "^1.85.0",
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "keywords": [
    "hex",
    "hex editor",
    "binary",
    "firmware",
    "embedded",
    "struct"
  ],
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Workspace-defined binary formats under .vscode/binary-viewer are only loaded in trusted workspaces. Raw hex viewing and global formats work everywhere."
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "customEditors": [
      {
        "viewType": "binaryViewer.hexEditor",
        "displayName": "Binary Viewer",
        "selector": [
          {
            "filenamePattern": "*.bin"
          },
          {
            "filenamePattern": "*.hex"
          },
          {
            "filenamePattern": "*.img"
          },
          {
            "filenamePattern": "*.dat"
          },
          {
            "filenamePattern": "*.fw"
          },
          {
            "filenamePattern": "*.rom"
          },
          {
            "filenamePattern": "*.dump"
          },
          {
            "filenamePattern": "*.raw"
          },
          {
            "filenamePattern": "*.eeprom"
          },
          {
            "filenamePattern": "*.nvram"
          }
        ],
        "priority": "option"
      }
    ],
    "commands": [
      {
        "command": "binaryViewer.goToOffset",
        "title": "Go To Offset",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.search",
        "title": "Search",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.findNext",
        "title": "Find Next",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.findPrevious",
        "title": "Find Previous",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.toggleStructureView",
        "title": "Toggle Structure View",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.toggleSectionsView",
        "title": "Toggle Sections View",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.toggleInspector",
        "title": "Toggle Inspector",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.showFieldInRawView",
        "title": "Show Field in Raw View",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.selectFormat",
        "title": "Select Binary Format",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.createFormat",
        "title": "Create Binary Format",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.generateFormat",
        "title": "Generate Binary Format From File",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.editFormat",
        "title": "Edit Binary Format",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.duplicateFormat",
        "title": "Duplicate Binary Format",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.deleteFormat",
        "title": "Delete Binary Format",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.importFormat",
        "title": "Import Binary Format",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.exportFormat",
        "title": "Export Binary Format",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.reloadFormats",
        "title": "Reload Binary Formats",
        "category": "Binary Viewer"
      },
      {
        "command": "binaryViewer.validateFormatFile",
        "title": "Validate Binary Format File",
        "category": "Binary Viewer",
        "icon": "$(check)"
      },
      {
        "command": "binaryViewer.applyFormatFile",
        "title": "Apply Binary Format File",
        "category": "Binary Viewer",
        "icon": "$(sync)"
      },
      {
        "command": "binaryViewer.openWith",
        "title": "Open With Binary Viewer",
        "category": "Binary Viewer"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "binaryViewer.goToOffset",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.search",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.findNext",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.findPrevious",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.toggleStructureView",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.toggleSectionsView",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.toggleInspector",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.showFieldInRawView",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.selectFormat",
          "when": "binaryViewer.active"
        },
        {
          "command": "binaryViewer.generateFormat",
          "when": "binaryViewer.active"
        }
      ],
      "explorer/context": [
        {
          "command": "binaryViewer.openWith",
          "group": "navigation@30",
          "when": "!explorerResourceIsFolder"
        }
      ],
      "editor/title": [
        {
          "command": "binaryViewer.validateFormatFile",
          "when": "binaryViewer.formatFileOpen",
          "group": "navigation@1"
        },
        {
          "command": "binaryViewer.applyFormatFile",
          "when": "binaryViewer.formatFileOpen",
          "group": "navigation@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "binaryViewer.goToOffset",
        "key": "ctrl+g",
        "mac": "cmd+g",
        "when": "binaryViewer.active && !inputFocus"
      },
      {
        "command": "binaryViewer.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "binaryViewer.active && !inputFocus"
      },
      {
        "command": "binaryViewer.findNext",
        "key": "f3",
        "when": "binaryViewer.active && !inputFocus"
      },
      {
        "command": "binaryViewer.findPrevious",
        "key": "shift+f3",
        "when": "binaryViewer.active && !inputFocus"
      },
      {
        "command": "binaryViewer.toggleStructureView",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "binaryViewer.active && !inputFocus"
      },
      {
        "command": "binaryViewer.toggleSectionsView",
        "key": "ctrl+alt+m",
        "mac": "cmd+alt+m",
        "when": "binaryViewer.active && !inputFocus"
      },
      {
        "command": "binaryViewer.toggleInspector",
        "key": "ctrl+alt+i",
        "mac": "cmd+alt+i",
        "when": "binaryViewer.active && !inputFocus"
      }
    ],
    "configuration": {
      "title": "Binary Viewer",
      "properties": {
        "binaryViewer.bytesPerRow": {
          "type": "number",
          "enum": [
            8,
            16,
            32
          ],
          "default": 16,
          "description": "Default number of bytes displayed per row in the raw hex view."
        },
        "binaryViewer.byteGroup": {
          "type": "string",
          "enum": [
            "1",
            "2le",
            "2be",
            "4le",
            "4be",
            "8le",
            "8be"
          ],
          "enumDescriptions": [
            "Plain bytes",
            "16-bit words, bytes reversed (little-endian reads as a number)",
            "16-bit words, kept in file order",
            "32-bit words, bytes reversed",
            "32-bit words, kept in file order",
            "64-bit words, bytes reversed",
            "64-bit words, kept in file order"
          ],
          "default": "1",
          "markdownDescription": "How the **raw** hex view groups bytes into words (this does not affect the structure decoder or the inspector). `·LE` reverses the bytes so a little-endian `01 00 00 00` reads as `00000001`; `·BE` keeps file order. Remembered per file from the toolbar's **Group** control."
        },
        "binaryViewer.fieldColors.enabledByDefault": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Enable **Field Colors** by default when opening a file with an applied format. A remembered per-file choice takes precedence."
        },
        "binaryViewer.fieldColors.brightness": {
          "type": "integer",
          "default": 20,
          "minimum": 10,
          "maximum": 60,
          "markdownDescription": "Intensity of the field-color backgrounds in the Raw view, from `10` to `60` percent. Existing out-of-range values are clamped to these limits. The default `20` keeps byte text readable. Field-name tag swatches retain their full colors. Changes apply to open viewers."
        },
        "binaryViewer.fieldColors.maxTags": {
          "type": "integer",
          "default": 8,
          "minimum": 0,
          "markdownDescription": "Maximum field-name tags shown above the Raw view when **Field Colors** is enabled. Tags identify top-level fields intersecting the visible bytes, using the same colors as the hex dump. Click a tag to select its field. Set to `0` to hide tags while keeping byte colors. Changes apply to open viewers."
        },
        "binaryViewer.formatEditor.offsetBase": {
          "type": "string",
          "enum": [
            "hex",
            "decimal"
          ],
          "default": "hex",
          "markdownDescription": "How the **Layout Preview** in the Binary Format editor prints byte offsets. Changes apply to open editors."
        },
        "binaryViewer.defaultEndianness": {
          "type": "string",
          "enum": [
            "little",
            "big"
          ],
          "default": "little",
          "description": "Default endianness used by the data inspector and by formats that do not specify one."
        },
        "binaryViewer.defaultView": {
          "type": "string",
          "enum": [
            "raw",
            "structure",
            "sections"
          ],
          "default": "raw",
          "description": "Which tab a binary file opens on. 'structure' and 'sections' fall back to 'raw' when no format applies to the file. The last tab you used for a given file is remembered and takes precedence."
        },
        "binaryViewer.baseAddress": {
          "type": "string",
          "default": "",
          "markdownDescription": "Show the offset / address columns relative to this base address instead of `0` — e.g. `0x08000000` for memory-mapped flash, so addresses line up with the datasheet or linker map. Accepts `0x` hex, decimal, or `…h`. A format's own `baseAddress` property overrides this. Leave empty for plain file offsets."
        },
        "binaryViewer.structure.maxArrayElements": {
          "type": "number",
          "default": 1000,
          "minimum": 0,
          "markdownDescription": "Maximum number of elements rendered per `array` field in the Structure view (the rest are summarised as one \"… N more\" row). This is the authoritative limit — raise it to see more, even for large nested arrays; a bigger Structure tree parses and renders more slowly. Set to `0` for no limit (a ~1,000,000-node safety backstop still applies)."
        },
        "binaryViewer.additionalExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "Extra file extensions (e.g. `s19`, `.mot`, `.pkg`) to open in the Binary Viewer automatically. The built-in list (`.bin .hex .img .dat .fw .rom .dump .raw .eeprom .nvram`) always works; this adds to it. A file opened as text can still be reopened with **Open With…**."
        },
        "binaryViewer.timestamp.defaultEpoch": {
          "type": "string",
          "enum": [
            "unix",
            "y2k",
            "gps",
            "mac",
            "filetime"
          ],
          "enumDescriptions": [
            "1970-01-01 UTC (POSIX)",
            "2000-01-01 UTC",
            "1980-01-06 UTC (GPS, leap seconds ignored)",
            "1904-01-01 UTC (classic Mac / HFS+)",
            "1601-01-01 UTC, value counted in 100-ns ticks (Windows FILETIME)"
          ],
          "default": "unix",
          "description": "Epoch assumed for `timestamp` fields that do not set their own `epoch`. A field's own timestamp.epoch always wins."
        },
        "binaryViewer.timestamp.displayUTC": {
          "type": "boolean",
          "default": true,
          "description": "Show decoded timestamps as a UTC ISO string. Turn off to show them in the host machine's local time zone."
        },
        "binaryViewer.showInspectorByDefault": {
          "type": "boolean",
          "default": true,
          "description": "Show the data inspector panel when a binary file is opened."
        },
        "binaryViewer.cacheWindowBytes": {
          "type": "number",
          "default": 8388608,
          "minimum": 262144,
          "description": "Maximum number of bytes kept in the extension-host read cache per open file."
        },
        "binaryViewer.blockSizeBytes": {
          "type": "number",
          "default": 65536,
          "minimum": 4096,
          "description": "Granularity (in bytes) of range reads and caching."
        },
        "binaryViewer.autoDetectFormat": {
          "type": "boolean",
          "default": true,
          "description": "Automatically detect a matching binary format (by extension and magic bytes) when opening a file."
        },
        "binaryViewer.formatDirectories": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "machine-overridable",
          "markdownDescription": "Extra folders to load binary format definitions (`*.json`) from — e.g. a shared network drive so the same formats are available on another machine. Absolute paths; `~` and `${workspaceFolder}` are expanded. These override global-storage formats but are overridden by workspace formats. New / changed files are picked up automatically."
        },
        "binaryViewer.showBuiltinFormats": {
          "type": "boolean",
          "default": true,
          "description": "Include the extension's built-in example formats in the Format dropdown and in automatic format detection. Turn off to show only your own formats."
        },
        "binaryViewer.maxSearchResults": {
          "type": "number",
          "default": 5000,
          "description": "Maximum number of matches returned by 'Find All'."
        }
      }
    }
  },
  "scripts": {
    "preinstall": "node scripts/check-node.js",
    "vscode:prepublish": "node esbuild.js --production && npm run check-types",
    "esbuild": "node esbuild.js",
    "check-types": "tsc -p tsconfig.json && tsc -p tsconfig.webview.json",
    "compile": "node esbuild.js && npm run check-types",
    "watch": "node esbuild.js --watch",
    "lint": "eslint src --ext ts",
    "compile-tests": "tsc -p tsconfig.test.json",
    "pretest": "npm run compile-tests",
    "test:unit": "mocha \"out/test/unit/**/*.test.js\"",
    "test:integration": "node ./out/test/runIntegration.js",
    "test": "npm run test:unit",
    "gen-fixtures": "node scripts/gen-fixtures.js",
    "gen-icon": "node scripts/gen-icon.js",
    "gen-screenshots": "node scripts/gen-screenshots.js",
    "package": "node scripts/clean-vsix.js && npm run check-types && node esbuild.js --production && npx --yes @vscode/vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^21.1.7",
    "@types/mocha": "^10.0.6",
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vscode/test-electron": "^2.3.9",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "glob": "^10.3.10",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "mocha": "^12.0.3",
    "typescript": "^5.4.0"
  }
}
