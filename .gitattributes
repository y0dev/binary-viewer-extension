# Normalise line endings so the repo builds identically on Windows, macOS, Linux
# and WSL. Text is stored LF; these files must stay LF on checkout everywhere.
* text=auto eol=lf

*.ts   text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.cjs  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.yml  text eol=lf
*.sh   text eol=lf

# Binary assets — never touch these (no EOL conversion, no diff munging).
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.vsix  binary
*.bin   binary
*.fw    binary
*.rom   binary
*.img   binary
*.hex   binary
*.dat   binary
*.raw   binary
*.dump  binary
*.eeprom binary
*.nvram binary
*.pkt   binary
*.wav   binary
*.mbr   binary
*.elf   binary
*.o     binary
